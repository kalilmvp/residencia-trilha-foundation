      "id": "s3-101",
      "x": 1030,
      "y": 2453,
      "width": 380.25,
      "height": 56.25,
      "text": "residencia-lambda-sg \u2192 residencia-proxy-sg :5432\nresidencia-proxy-sg \u2192 residencia-rds-sg :5432\nresidencia-lambda-sg \u2192 residencia-endpoints-sg :443",
      "originalText": "residencia-lambda-sg \u2192 residencia-proxy-sg :5432\nresidencia-proxy-sg \u2192 residencia-rds-sg :5432\nresidencia-lambda-sg \u2192 residencia-endpoints-sg :443",
