      "type": "text",
      "id": "s3-102",
      "x": 145,
      "y": 2544,
      "width": 856.95,
      "height": 18.75,
      "text": "RDS Proxy exposes its own database connection endpoint; it is separate from the SQS / Secrets Manager API endpoints.",
      "originalText": "RDS Proxy exposes its own database connection endpoint; it is separate from the SQS / Secrets Manager API endpoints.",
      "fontSize": 15,
      "fontFamily": 2,
