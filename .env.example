# copy to .env and fill in - .env is gitignored
AWS_PROFILE=devops-curso
AWS_REGION=us-east-1

# used by infrastructure/cloudformation/scripts/create-web-edge-changeset.sh
STACK_NAME=web-edge-sandbox-2
DOMAIN_NAME=sub.example.com
DNS_NAME=example.com

# used by both scripts; DISTRIBUTION_ID comes from the stack output
BUCKET_NAME=your-bucket-name-<account-id>
DISTRIBUTION_ID=EXXXXXXXXXXXXX
